        },
        {
          "name": "Inclusive bounds on 2 elements",
          "input": [null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",1,3]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Inclusive bounds on 3 elements",
          "input": [null,null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",1,3]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Inclusive bounds on 4 elements",
          "input": [null,null,null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",1,3]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Unbounded max on 0 elements",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,-1]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Unbounded max on 1 elements",
          "input": [null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,-1]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Unbounded max on 2 elements",
          "input": [null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,-1]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Unbounded max on 3 elements",
          "input": [null,null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,-1]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Unbounded max on 4 elements",
          "input": [null,null,null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,-1]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Zero exact on 0 elements",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",0]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Zero exact on 1 elements",
          "input": [null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",0]]]],["NODE"]]],
          "lazy": {"output":false}
