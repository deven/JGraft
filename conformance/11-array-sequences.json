{
  "version": 1,
  "name": "Array sequences",
  "desc": "Capture-free sequence matching, repetitions, assertions and successor positions.",
  "tests": [
    {
      "name": "Sequence composition and anchors",
      "desc": "HAS accepts a prefix. IS requires a successor at the end of the array. Assertions leave the cursor in place.",
      "tests": [
        {
          "name": "Empty sequence on empty array",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["SEQ"]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Empty sequence cannot cover one element",
          "input": [0],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["SEQ"]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Nested sequence preserves order",
          "input": [1,2,3],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["SEQ",1,["SEQ",2],3]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Mismatched nested sequence",
          "input": [1,3,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["SEQ",1,["SEQ",2],3]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Start and end coincide",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["START"],["END"]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Start and end differ",
          "input": [null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["START"],["END"]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "START after a consumed element",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[1,["START"]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Anchored sequence consumes every element",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["START"],1,2,["END"]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Repeated END remains at end",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[1,["END"],["END"]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Node required after END",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["END"],["EXISTS"]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Partial sequence can leave a suffix",
          "input": [0,1,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["HAS",[[["SEQ",0,1]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Partial sequence still starts at zero",
          "input": [0,1,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["HAS",[[["SEQ",1,2]]]],["NODE"]]],
          "lazy": {"output":false}
        }
      ]
    },
    {
      "name": "Repetition bounds",
