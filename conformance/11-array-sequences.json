        {
          "name": "Zero exact on 3 elements",
          "input": [null,null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",0]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Zero exact on 4 elements",
          "input": [null,null,null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",0]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Explicit wildcard on 0 elements",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,3,["EXISTS"]]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Explicit wildcard on 1 elements",
          "input": [null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,3,["EXISTS"]]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Explicit wildcard on 2 elements",
          "input": [null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,3,["EXISTS"]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Explicit wildcard on 3 elements",
          "input": [null,null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,3,["EXISTS"]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Explicit wildcard on 4 elements",
          "input": [null,null,null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,3,["EXISTS"]]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Each repetition may consume two elements",
          "input": ["a","b","a","b"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,0,["SEQ","a","b"]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Wrong element in second occurrence",
          "input": ["a","b","a","c"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,0,["SEQ","a","b"]]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Shorter repetition leaves room for a required suffix",
