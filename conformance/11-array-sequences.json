          "lazy": {"output":true}
        },
        {
          "name": "Computed bounds resolve a constant",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1,"const":["count",2]},["COPY",["IS",[[["REP",["CONST","count"],0,["EXISTS"]]]]],["NODE"]]],
          "lazy": {"output":true}
        }
      ]
    },
    {
      "name": "Repetition at a candidate position",
      "desc": "REP evaluates its bounds with the current element and index at the start of each run. The final position has an index and no element.",
      "tests": [
        {
          "name": "Read the exact bound at each start",
          "desc": "The first run consumes one element and the second consumes two. Reusing a single exact bound cannot cover three elements.",
          "input": [1,2,"tail"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,0,["REP",["NODE"]]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Read the initial index at each start",
          "desc": "The runs start at indices 0 and 1, giving exact counts of one and two.",
          "input": ["a","b","c"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,0,["REP",["ADD",1,["CURPROP"]]]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Rebind the count through WITH and TEMP",
          "input": [{"n":1},{"n":2},null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,0,["WITH",["REP",["TEMP","width"]],"width",["NODE","n"]]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Second run permits two elements",
          "input": [{"max":1,"part":true},"stop",{"max":2,"part":true},{"part":true},"stop"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,0,["SEQ",["REP",1,["NODE","max"],["HAS",{"part":true}]],"stop"]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Second run permits only one element",
          "input": [{"max":2,"part":true},"stop",{"max":1,"part":true},{"part":true},"stop"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",2,0,["SEQ",["REP",1,["NODE","max"],["HAS",{"part":true}]],"stop"]]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "A zero-width repetition can succeed at the final position",
          "input": ["a"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[["a",["REP",1,0,["SEQ"]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Reading NODE at the final position fails a zero-width repetition",
          "desc": "The empty sequence can repeat once even at the end. Constructing the array for LENGTH requires an existing current node.",
          "input": ["a"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[["a",["REP",["LENGTH",[[["NODE"]]]],0,["SEQ"]]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "CANT observes the failed read at the final position",
          "input": ["a"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[["a",["CANT",["REP",["LENGTH",[[["NODE"]]]],0,["SEQ"]]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Final cursor index equals the length of a nonempty array",
          "desc": "At the end only a count of zero succeeds. Subtracting the final cursor index from two must give zero.",
          "input": ["a","b"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[["a","b",["REP",["SUB",2,["CURPROP"]]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Final cursor index of an empty array",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["REP",["CURPROP"]]]]],["NODE"]]],
          "lazy": {"output":true}
        }
      ]
    },
    {
      "name": "Successor union and intersection",
      "desc": "ANY retains viable alternative ends. ALL requires a common end, including when the following pattern rules out an otherwise viable end.",
      "tests": [
        {
          "name": "Short successor needed",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ANY",["SEQ",1,2],1],2]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Long successor needed",
          "input": [1,2,3],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ANY",1,["SEQ",1,2]],3]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Empty alternative at end",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[1,["ANY",2,["SEQ"]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Alternatives both fail",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ANY",["SEQ",2],3]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Only shared successor satisfies suffix",
          "input": [1,2,3],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ALL",["REP",1,2],["REP",2,3]],3]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Disjoint nonempty successor sets",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ALL",["REP",1],["REP",2]],["REP"]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Shared successor cannot satisfy suffix",
          "input": [1,2,3],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ALL",["REP",1,2],["REP",2,3]],2]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Shared zero-width successor",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ALL",["SEQ"],["REP",0,1]],1]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Nested union inside intersection",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ALL",["ANY",1,["SEQ",1,2]],["REP",2]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Alternatives test the same element",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["ALL",["NUM"],["EXISTS"]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "NONE consumes one node",
          "input": [2,3],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["NONE",1],3]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "NONE cannot consume at end",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["NONE",1]]]],["NODE"]]],
          "lazy": {"output":false}
        }
      ]
    },
    {
      "name": "Lookahead",
      "desc": "CAN and CANT test a sequence at the current position without advancing. A failed probe counts as a failed match.",
      "tests": [
        {
          "name": "Empty CAN at end",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["CAN"]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Empty CANT at end",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["CANT"]]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Positive multi-element lookahead",
          "input": ["a","b"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["CAN","a","b"],"a","b"]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "CAN requires its entire sequence",
          "input": ["a","x"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["CAN","a","b"],"a","x"]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Negative lookahead succeeds",
          "input": ["a","x"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["CANT","a","b"],"a","x"]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Negative lookahead blocks",
          "input": ["a","b"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["CANT","a","b"],"a","b"]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Lookahead at end",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[1,["CAN",["END"]],["CANT",["EXISTS"]]]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Nested negative assertions",
          "input": [1],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",[[["CANT",["CANT",1]],1]]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
