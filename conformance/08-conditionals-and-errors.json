{
  "version": 1,
  "name": "Conditionals and errors",
  "desc": "Conditional actions and values, boolean short-circuiting, failure in value and match contexts, and ordered diagnostic records.",
  "tests": [
    {
      "name": "IF",
      "desc": "Each condition is a pattern. Only the first matching action runs.",
      "tests": [
        {
          "name": "First of two overlapping patterns wins",
          "input": {"active":true,"id":7},
          "jgraft": ["JGRAFT",{"v":1},["IF",{"id":7},["COPY","first",["NODE"]],{"active":true},["COPY","second",["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"output":"first"}
        },
        {
          "name": "Only the second condition matches",
          "input": "b",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY","first",["NODE"]],"b",["COPY","second",["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"output":"second"}
        },
        {
          "name": "Final fallback after two misses",
          "input": "c",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY","first",["NODE"]],"b",["COPY","second",["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"output":"fallback"}
        },
        {
          "name": "Single matching pair without fallback",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY","selected",["NODE"]]]],
          "lazy": {"output":"selected"}
        },
        {
          "name": "Unmatched pair without fallback",
          "input": "other",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY","selected",["NODE"]]]],
          "lazy": {"output":"other"}
        },
        {
          "name": "False is a literal pattern",
          "input": false,
          "jgraft": ["JGRAFT",{"v":1},["IF",false,["COPY","matched",["NODE"]],["COPY","missed",["NODE"]]]],
          "lazy": {"output":"matched"}
        },
        {
          "name": "True pattern differs from numeric one",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["IF",true,["COPY","matched",["NODE"]],["COPY","missed",["NODE"]]]],
          "lazy": {"output":"missed"}
        },
        {
          "name": "Function condition compares its boolean result with the node",
          "input": 2,
          "jgraft": ["JGRAFT",{"v":1},["IF",["LESS",["NODE"],3],["COPY","matched",["NODE"]],["COPY","missed",["NODE"]]]],
          "lazy": {"output":"missed"}
        },
        {
          "name": "Explicit predicate uses the boolean result to choose a branch",
          "input": 2,
          "jgraft": ["JGRAFT",{"v":1},["IF",["IS",true,["LESS",["NODE"],3]],["COPY","matched",["NODE"]],["COPY","missed",["NODE"]]]],
          "lazy": {"output":"matched"}
        },
        {
          "name": "A condition probe can fail and a later condition still match",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["IF",["NODE","absent"],["COPY","first",["NODE"]],{},["COPY","second",["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"output":"second"}
        },
        {
          "name": "Explicit FAIL in a condition is a miss",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["IF",["FAIL"],["COPY","first",["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"output":"fallback"}
        },
        {
          "name": "Selected branch reads the enclosing node",
          "input": {"target":2,"v":"caller"},
          "jgraft": ["JGRAFT",{"v":1},["IF",["IS",2,["NODE","target"]],["COPY",["NODE","v"],["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"output":"caller"}
        },
        {
          "name": "Selected failure stops evaluation",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY",["FAIL"],["NODE"]],"a",["COPY","second",["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Failing fallback is reached",
          "input": "other",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY","first",["NODE"]],["COPY",["FAIL"],["NODE"]]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Skipped result can fail at runtime",
          "input": "b",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY",["FAIL"],["NODE"]],"b",["COPY","selected",["NODE"]],["COPY",["FAIL"],["NODE"]]]],
          "lazy": {"output":"selected"}
        },
        {
          "name": "Selected outer branch evaluates a nested choice",
          "input": {"a":1,"b":2},
          "jgraft": ["JGRAFT",{"v":1},["IF",{"a":1},["COPY",["CASE",{"b":2},"both","only a"],["NODE"]],["COPY","neither",["NODE"]]]],
          "lazy": {"output":"both"}
        },
        {
          "name": "Malformed first condition propagates",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["IF",["BOOL",1],["COPY","first",["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Malformed later condition follows a match",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY","first",["NODE"]],["BOOL",1],["COPY","second",["NODE"]]]],
          "lazy": {"output":"first"},
          "strict": {"invalid_graft":true}
        },
        {
          "name": "Malformed branch expression is skipped",
          "input": "b",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY",["FAIL",0],["NODE"]],["COPY","fallback",["NODE"]]]],
          "lazy": {"output":"fallback"},
          "strict": {"invalid_graft":true}
        },
        {
          "name": "A selected action's NO_MATCH bypasses the else action",
          "input": {"ready":true},
          "jgraft": ["JGRAFT",{"v":1},["IF",{"ready":true},["MATCH",{"ok":true}],["COPY","fallback",["NODE"]]]],
          "lazy": {"no_match":true}
        },
        {
          "name": "No branches",
          "input": 7,
          "jgraft": ["JGRAFT",{"v":1},["IF"]],
          "lazy": {"output":7}
        },
        {
          "name": "Only an else action",
          "input": 7,
          "jgraft": ["JGRAFT",{"v":1},["IF",["COPY","default",["NODE"]]]],
          "lazy": {"output":"default"}
        },
        {
          "name": "Selected branch requires an action",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["LENGTH","x"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "IF rejects an unknown else action even when the first branch matches",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY",1,["NODE"]],["unknown-action"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "IF skips the arity check inside an unused COPY",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["IF","a",["COPY",1,["NODE"]],["COPY"]]],
          "lazy": {"output":1},
          "strict": {"invalid_graft":true}
        },
        {
          "name": "Later IF sees an edit made by an earlier IF",
          "input": {"n":0},
          "jgraft": ["JGRAFT",{"v":1},["IF",{"n":0},["COPY",1,"n"]],["IF",{"n":1},["COPY","done","state"]]],
          "lazy": {"output":{"n":1,"state":"done"}}
        }
      ]
    },
    {
      "name": "CASE",
      "desc": "The first matching condition selects a value expression. Without a match or an explicit fallback, CASE raises a runtime error.",
      "tests": [
        {
          "name": "First of two overlapping patterns wins",
          "input": {"active":true,"id":7},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",{"id":7},"first",{"active":true},"second","fallback"],["NODE"]]],
          "lazy": {"output":"first"}
        },
        {
          "name": "Only the second condition matches",
          "input": "b",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a","first","b","second","fallback"],["NODE"]]],
          "lazy": {"output":"second"}
        },
        {
          "name": "Final fallback after two misses",
          "input": "c",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a","first","b","second","fallback"],["NODE"]]],
          "lazy": {"output":"fallback"}
        },
        {
          "name": "Single matching pair without fallback",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a","selected"],["NODE"]]],
          "lazy": {"output":"selected"}
        },
        {
          "name": "Unmatched pair without fallback",
          "input": "other",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a","selected"],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "False is a literal pattern",
          "input": false,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",false,"matched","missed"],["NODE"]]],
          "lazy": {"output":"matched"}
        },
        {
          "name": "True pattern differs from numeric one",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",true,"matched","missed"],["NODE"]]],
          "lazy": {"output":"missed"}
        },
        {
          "name": "Function condition compares its boolean result with the node",
          "input": 2,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",["LESS",["NODE"],3],"matched","missed"],["NODE"]]],
          "lazy": {"output":"missed"}
        },
        {
          "name": "Explicit predicate uses the boolean result to choose a branch",
          "input": 2,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",["IS",true,["LESS",["NODE"],3]],"matched","missed"],["NODE"]]],
          "lazy": {"output":"matched"}
        },
        {
          "name": "A condition probe can fail and a later condition still match",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",["NODE","absent"],"first",{},"second","fallback"],["NODE"]]],
          "lazy": {"output":"second"}
        },
        {
          "name": "Explicit FAIL in a condition is a miss",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",["FAIL"],"first","fallback"],["NODE"]]],
          "lazy": {"output":"fallback"}
        },
        {
          "name": "Selected branch reads the enclosing node",
          "input": {"target":2,"v":"caller"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",["IS",2,["NODE","target"]],["NODE","v"],"fallback"],["NODE"]]],
          "lazy": {"output":"caller"}
        },
        {
          "name": "Selected failure stops evaluation",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a",["FAIL"],"a","second","fallback"],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Failing fallback is reached",
          "input": "other",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a","first",["FAIL"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Skipped result can fail at runtime",
          "input": "b",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a",["FAIL"],"b","selected",["FAIL"]],["NODE"]]],
          "lazy": {"output":"selected"}
        },
        {
          "name": "Selected outer branch evaluates a nested choice",
          "input": {"a":1,"b":2},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",{"a":1},["CASE",{"b":2},"both","only a"],"neither"],["NODE"]]],
          "lazy": {"output":"both"}
        },
        {
          "name": "Malformed first condition propagates",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",["BOOL",1],"first","fallback"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Malformed later condition follows a match",
          "input": "a",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a","first",["BOOL",1],"second"],["NODE"]]],
          "lazy": {"output":"first"},
          "strict": {"invalid_graft":true}
        },
        {
          "name": "Malformed branch expression is skipped",
          "input": "b",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","a",["FAIL",0],"fallback"],["NODE"]]],
          "lazy": {"output":"fallback"},
          "strict": {"invalid_graft":true}
        },
        {
          "name": "No condition/result pairs",
          "input": 0,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "A fallback alone is too few operands",
          "input": 0,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE","fallback"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Null is a selected result",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",1,null,"fallback"],["NODE"]]],
          "lazy": {"output":null}
        },
        {
          "name": "Boolean false is a selected result",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",1,false,"fallback"],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Zero is a selected result",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",1,0,"fallback"],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "Empty string is a selected result",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",1,"","fallback"],["NODE"]]],
          "lazy": {"output":""}
        },
        {
          "name": "Empty array is a selected result",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",1,[[]],"fallback"],["NODE"]]],
          "lazy": {"output":[]}
        },
        {
          "name": "Empty object is a selected result",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",1,{},"fallback"],["NODE"]]],
          "lazy": {"output":{}}
        },
        {
          "name": "Construct a result from current properties",
          "input": {"id":4},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CASE",{"id":["NUM"]},{"found":["NODE","id"],"items":[[["NODE","id"]]]},null],["NODE"]]],
          "lazy": {"output":{"found":4,"items":[4]}}
        },
        {
          "name": "Implied failure is trapped by an enclosing predicate",
          "input": "unmatched",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",0,["CASE","expected",0]],["NODE"]]],
          "lazy": {"output":false}
        }
      ]
    },
    {
      "name": "AND",
      "desc": "Operands evaluate from left to right through the first false value.",
      "tests": [
        {
          "name": "Single false",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",false],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Single true",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",true],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "False then false",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",false,false],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "False then true",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",false,true],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "True then false",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",true,false],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "True then true",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",true,true],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Third operand determines result",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",true,true,false],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Reference and predicate as boolean operands",
          "input": {"flag":true},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",["NODE","flag"],["EXISTS","flag"]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Decisive operand skips FAIL",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",false,["FAIL"]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Decisive operand skips a missing reference",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",false,["NODE","missing"]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "FAIL reached before a later decisive value",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",true,["FAIL"],false],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Wrong type from input",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",true,["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Literal number is an invalid boolean operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",true,1],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "No operands",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Short-circuit operand must have a compatible result type",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",false,["LENGTH"]],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Invalid literal takes priority over a missing reference",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["AND",["NODE","missing"],1],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Computed operand failure becomes a miss in a predicate",
          "input": {"v":"true"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",true,["AND",["NODE","v"]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Invalid boolean operand escapes a predicate",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["NONE",["AND","true"]],["NODE"]]],
          "lazy": {"invalid_graft":true}
        }
      ]
    },
    {
      "name": "OR",
      "desc": "Operands evaluate from left to right through the first true value.",
      "tests": [
        {
          "name": "Single false",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",false],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "Single true",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",true],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "False then false",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",false,false],["NODE"]]],
          "lazy": {"output":false}
        },
        {
          "name": "False then true",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",false,true],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "True then false",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",true,false],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "True then true",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",true,true],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Third operand determines result",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",false,false,true],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Reference and predicate as boolean operands",
          "input": {"flag":false},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",["NODE","flag"],["EXISTS","flag"]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Decisive operand skips FAIL",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",true,["FAIL"]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "Decisive operand skips a missing reference",
