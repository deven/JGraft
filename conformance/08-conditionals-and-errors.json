          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",true,["NODE","missing"]],["NODE"]]],
          "lazy": {"output":true}
        },
        {
          "name": "FAIL reached before a later decisive value",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",false,["FAIL"],true],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Wrong type from input",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",false,["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Literal number is an invalid boolean operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",false,1],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "No operands",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Short-circuit operand must have a compatible result type",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",true,["LENGTH"]],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Missing opcode in a short-circuited operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",true,[]],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Short circuit skips the arity check inside BOOL",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",true,["BOOL",1]],["NODE"]]],
          "lazy": {"output":true},
          "strict": {"invalid_graft":true}
        },
        {
          "name": "Invalid literal takes priority over a missing reference",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["OR",["NODE","missing"],1],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Computed operand failure becomes a miss in a predicate",
          "input": {"v":"true"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["IS",true,["OR",["NODE","v"]]],["NODE"]]],
          "lazy": {"output":false}
        },
        {
