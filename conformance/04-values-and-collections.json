          "input": [[],null,[1,2]],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LENGTH"],["NODE"]]],
          "lazy": {"output":3}
        },
        {
          "name": "Count codepoints including a combining mark and NUL",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LENGTH","A😀é\u0000"],["NODE"]]],
          "lazy": {"output":5}
        },
        {
          "name": "Count codepoints in a referenced string",
          "input": {"text":"😀"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LENGTH",["NODE","text"]],["NODE"]]],
          "lazy": {"output":1}
        },
        {
          "name": "Literal object",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LENGTH",{"length":2}],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Input of type object",
          "input": {"length":2},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LENGTH"],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Literal null",
