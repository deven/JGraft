{
  "version": 1,
  "name": "Values and collections",
  "desc": "Literal data, array and string lengths and concatenation, sorted object names and pairs, and construction from pairs and overrides.",
  "tests": [
    {
      "name": "DATA",
      "tests": [
        {
          "name": "Null literal",
          "input": 42,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DATA",null],["NODE"]]],
          "lazy": {"output":null}
        },
        {
          "name": "Quote the empty array",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DATA",[]],["NODE"]]],
          "lazy": {"output":[]}
        },
        {
          "name": "Escape wrapper is literal",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DATA",[[1,2]]],["NODE"]]],
          "lazy": {"output":[[1,2]]}
        },
        {
          "name": "Nested directive arrays are opaque",
          "input": {"x":7},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DATA",{"empty":{},"list":[[["UNKNOWN"],[],["COPY"]]],"ref":["NODE","x"]}],["NODE"]]],
          "lazy": {"output":{"empty":{},"list":[[["UNKNOWN"],[],["COPY"]]],"ref":["NODE","x"]}}
        },
        {
          "name": "Unquoted object and escaped array evaluate their children",
          "input": {"x":7},
          "jgraft": ["JGRAFT",{"v":1},["COPY",{"list":[[["NODE","x"]]],"ref":["NODE","x"]},["NODE"]]],
          "lazy": {"output":{"list":[7],"ref":7}}
        },
        {
          "name": "Quoted object preserves the same reference expressions",
          "input": {"x":7},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DATA",{"list":[[["NODE","x"]]],"ref":["NODE","x"]}],["NODE"]]],
          "lazy": {"output":{"list":[[["NODE","x"]]],"ref":["NODE","x"]}}
        },
        {
          "name": "Missing literal",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DATA"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Extra literal",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DATA",1,2],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Malformed call in skipped branch",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["DATA"],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        }
      ]
    },
    {
      "name": "LENGTH",
