        {
          "name": "Input of type boolean",
          "input": false,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LENGTH"],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Extra operand",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LENGTH","",""],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Malformed call in skipped branch",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["LENGTH","",""],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        }
      ]
