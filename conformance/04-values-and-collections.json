    {
      "name": "CONCAT",
      "tests": [
        {
          "name": "Repeated string operands",
          "input": "ab",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"],["NODE"],["NODE"]],["NODE"]]],
          "lazy": {"output":"ababab"}
        },
        {
          "name": "Single empty array",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "lazy": {"output":[]}
        },
        {
          "name": "Single string",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","one"],["NODE"]]],
          "lazy": {"output":"one"}
        },
        {
          "name": "Empty strings",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",""],["NODE"]]],
          "lazy": {"output":""}
        },
        {
          "name": "Preserve codepoints across operand boundaries",
          "input": {"tail":"́"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","","😀","e",["NODE","tail"],""],["NODE"]]],
          "lazy": {"output":"😀é"}
        },
        {
          "name": "An empty span contributes no elements",
          "input": {"left":[0,null],"right":[[],["NODE"],{"a":1}]},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE","left"],[[]],["NODE","right"]],["NODE"]]],
          "lazy": {"output":[0,null,[],["NODE"],{"a":1}]}
        },
        {
          "name": "Evaluate array elements before concatenating spans",
          "input": {"item":7,"tail":[[2,3]]},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",[[["NODE","item"]]],["NODE","tail"]],["NODE"]]],
          "lazy": {"output":[7,[2,3]]}
        },
        {
          "name": "Repeated operands contribute repeated elements",
          "input": [1,2],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"],["NODE"],["NODE"]],["NODE"]]],
          "lazy": {"output":[1,2,1,2,1,2]}
        },
        {
          "name": "At least one operand",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Literal string and array",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",[[]]],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "String and known array result separated by a reference",
          "input": "x",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT","",["NODE"],["PROPS",{}]],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Computed operands of different types",
          "input": {"a":[],"b":""},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Malformed call in skipped branch",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["CONCAT","",[[]]],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        },
        {
          "name": "Literal object",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",{"length":2}],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Input of type object",
          "input": {"length":2},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Literal null",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",null],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Input of type null",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Literal number",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",1],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Input of type number",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["CONCAT",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
