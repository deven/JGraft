        },
        {
          "name": "Integer option shifts the current value",
          "input": "1.23",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",2],["NODE"]]],
          "lazy": {"output":"123"}
        },
        {
          "name": "Computed shift and explicit value",
          "input": {"s":-1,"v":"125"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",["NODE","s"],["NODE","v"]],["NODE"]]],
          "lazy": {"output":"13"}
        },
        {
          "name": "Options object from input",
          "input": {"opts":{"at":2,"mode":"DOWN"},"v":"1.239"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",["NODE","opts"],["NODE","v"]],["NODE"]]],
          "lazy": {"output":"1.23"}
        },
        {
          "name": "Computed fields in options object",
          "input": {"p":-1,"s":2,"v":"1.23"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"INT","at":["NODE","p"],"shift":["NODE","s"]},["NODE","v"]],["NODE"]]],
          "lazy": {"output":120}
        },
        {
          "name": "NUM returns a fractional number",
          "input": "-1.249",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"NUM","at":2}],["NODE"]]],
          "lazy": {"output":-1.25}
        },
        {
          "name": "INT accepts a final integral value after shifting",
          "input": "1.25",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"INT","at":2,"shift":2}],["NODE"]]],
          "lazy": {"output":125}
        },
        {
          "name": "INT rejects a final fraction",
          "input": "1.25",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"INT","at":2}],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "STR pads to the requested decimal position",
          "input": 3,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR","at":3}],["NODE"]]],
          "lazy": {"output":"3.000"}
        },
        {
          "name": "STR writes full decimal digits",
          "input": "1.25e6",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR"}],["NODE"]]],
          "lazy": {"output":"1250000"}
        },
        {
          "name": "Carry across the decimal point",
          "input": "99.995",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"at":2}],["NODE"]]],
          "lazy": {"output":"100.00"}
        },
        {
          "name": "Negative at rounds within the integer part",
          "input": "-1250",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"at":-2}],["NODE"]]],
          "lazy": {"output":"-1300"}
        },
        {
          "name": "Leading plus and trailing decimal point",
          "input": "+45.",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"at":1}],["NODE"]]],
          "lazy": {"output":"45.0"}
        },
        {
          "name": "String-supplied negative zero retains sign and scale",
          "input": "-0.000",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"at":2}],["NODE"]]],
          "lazy": {"output":"-0.00"}
        },
        {
          "name": "Round negative input to signed zero",
          "input": "-0.125",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"at":0,"mode":"DOWN"}],["NODE"]]],
          "lazy": {"output":"-0"}
        }
      ]
