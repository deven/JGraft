          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "Fractional divisor",
          "input": {"a":-5.5,"b":2.25},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"output":1.25}
        },
        {
          "name": "Negative fractional divisor",
          "input": {"a":5.5,"b":-2.25},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"output":-1.25}
