          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW",2],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Base required",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Extra operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW",2,2,2],["NODE"]]],
