          "name": "Missing second operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",1],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Extra operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",1,2,3],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Null literal in first position",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",null,2],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "String returned for second operand",
          "input": {"v":"2"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",1,["NODE","v"]],["NODE"]]],
