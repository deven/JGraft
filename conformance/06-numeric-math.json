          "input": {"v":"2"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DIV",1,["NODE","v"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Invalid call in a skipped action",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["DIV",1],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        }
      ]
    },
    {
      "name": "MOD",
      "desc": "The nonzero modulus has the sign of the divisor, including for fractional operands.",
      "tests": [
        {
          "name": "Two positives",
          "input": {"a":7,"b":3},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"output":1}
        },
        {
          "name": "Negative dividend",
          "input": {"a":-7,"b":3},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"output":2}
        },
        {
          "name": "Negative divisor",
          "input": {"a":7,"b":-3},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"output":-2}
        },
        {
          "name": "Both negative",
          "input": {"a":-7,"b":-3},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MOD",["NODE","a"],["NODE","b"]],["NODE"]]],
