    {
      "name": "POW",
      "desc": "The unary form reads the exponent from the current node. A nonnegative base and the exponent determine the domain.",
      "tests": [
        {
          "name": "Implicit exponent",
          "input": 3,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW",2],["NODE"]]],
          "lazy": {"output":8}
        },
        {
          "name": "Both operands from the input",
          "input": {"b":5,"e":3},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW",["NODE","b"],["NODE","e"]],["NODE"]]],
          "lazy": {"output":125}
        },
        {
          "name": "Zero to zero",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW",0,0],["NODE"]]],
          "lazy": {"output":1}
        },
        {
          "name": "Zero to a positive fraction",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW",0,0.5],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "Nonzero base to zero",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW",4.5,0],["NODE"]]],
          "lazy": {"output":1}
        },
