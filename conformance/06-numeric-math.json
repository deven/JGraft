{
  "version": 1,
  "name": "Numeric math",
  "desc": "Arithmetic and its domains, decimal rounding, significant digits, and the portable precision and exponent range.",
  "tests": [
    {
      "name": "ADD",
      "desc": "A single operand supplies an array. Separate operands supply numbers and nulls in argument order.",
      "tests": [
        {
          "name": "Empty array identity",
          "input": [],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",["NODE"]],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "All-null array",
          "input": [null,null],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",["NODE"]],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "Null operands",
          "input": 2,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",null,null],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "Singleton array preserves its only number",
          "input": [-3],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",["NODE"]],["NODE"]]],
          "lazy": {"output":-3}
        },
        {
          "name": "Ignore null entries between signed numbers",
          "input": [-2,null,3,-0.5],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",["NODE"]],["NODE"]]],
          "lazy": {"output":0.5}
        },
        {
          "name": "Separate operands include a reference",
          "input": {"x":-3},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",2,null,["NODE","x"],4],["NODE"]]],
          "lazy": {"output":3}
        },
        {
          "name": "Constructed array evaluates its elements",
          "input": 4,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",[[2,["NODE"],null]]],["NODE"]]],
          "lazy": {"output":6}
        },
        {
          "name": "Zero among the operands",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",2,0,3],["NODE"]]],
          "lazy": {"output":5}
        },
        {
          "name": "Fifteen-digit integer result",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",123456789012344,1],["NODE"]]],
          "lazy": {"output":123456789012345}
        },
        {
          "name": "Decimal fractions observed at twelve places",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR","at":12},["ADD",0.1,0.2]],["NODE"]]],
          "lazy": {"output":"0.300000000000"}
        },
        {
          "name": "Single scalar literal",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",3],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Single computed scalar",
          "input": 3,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Single null is not an array",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Nested array is an invalid list element",
          "input": [1,[2]],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Numeric-looking string in array",
          "input": [0,"2"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Boolean among separate operands",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",0,false],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Later computed operand must be numeric or null",
          "input": {"x":"bad"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ADD",0,["NODE","x"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Invalid call in a skipped action",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["ADD",2],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        }
      ]
    },
    {
      "name": "MUL",
