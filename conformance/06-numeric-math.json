        {
          "name": "Zero divisor from input",
          "input": 0,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DIV",1,["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Zero divided by zero",
          "input": 0,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DIV",["NODE"],["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Missing both operands",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DIV"],["NODE"]]],
          "lazy": {"invalid_graft":true}
