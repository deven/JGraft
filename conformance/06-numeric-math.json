          "name": "Numeric string used as literal base",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW","2",3],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Boolean used as computed second operand",
          "input": true,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["POW",2,["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Invalid call in a skipped action",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["POW"],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        }
