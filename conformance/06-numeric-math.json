    {
      "name": "LOG",
      "desc": "The unary form reads the logarithm argument from the current node. Positive bases on either side of one are valid.",
      "tests": [
        {
          "name": "Implicit value",
          "input": 8,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR","at":8},["LOG",2]],["NODE"]]],
          "lazy": {"output":"3.00000000"}
        },
        {
          "name": "One has logarithm zero",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",0.25,1],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "Equal positive operands have logarithm one",
          "input": 0.25,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",["NODE"],["NODE"]],["NODE"]]],
          "lazy": {"output":1}
        },
        {
          "name": "Base below one gives a negative logarithm",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR","at":8},["LOG",0.5,8]],["NODE"]]],
          "lazy": {"output":"-3.00000000"}
        },
        {
          "name": "Value below one gives a negative logarithm",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR","at":8},["LOG",2,0.125]],["NODE"]]],
          "lazy": {"output":"-3.00000000"}
        },
        {
          "name": "Logarithm with fractional result",
          "input": {"b":10,"x":2},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR","at":12},["LOG",["NODE","b"],["NODE","x"]]],["NODE"]]],
          "lazy": {"output":"0.301029995664"}
        },
        {
          "name": "Base of one is invalid even when value is one",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",1,1],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Literal zero base",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",0,2],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Literal negative value",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",2,-3],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Computed negative base",
          "input": -3,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",["NODE"],1],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Computed base of one",
          "input": 1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",["NODE"],4],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Implicit zero value",
          "input": 0,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",2],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Implicit negative value",
          "input": -1,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",2],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Base required",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Extra operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",2,2,2],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Numeric string used as literal base",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG","2",3],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Boolean used as computed second operand",
          "input": true,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["LOG",2,["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Invalid call in a skipped action",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["LOG"],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        }
      ]
