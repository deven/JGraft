        },
        {
          "name": "Single computed scalar",
          "input": 3,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MUL",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Single null is not an array",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MUL",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Nested array is an invalid list element",
          "input": [1,[2]],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MUL",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Numeric-looking string in array",
          "input": [0,"2"],
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MUL",["NODE"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Boolean among separate operands",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MUL",0,false],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Later computed operand must be numeric or null",
          "input": {"x":"bad"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["MUL",0,["NODE","x"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Invalid call in a skipped action",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["MUL",2],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        }
      ]
    },
    {
      "name": "SUB",
      "desc": "Subtract the second operand from the first.",
      "tests": [
        {
          "name": "Positive difference",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",8,3],["NODE"]]],
          "lazy": {"output":5}
        },
        {
          "name": "Reversing operands changes the sign",
          "input": 3,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",["NODE"],8],["NODE"]]],
          "lazy": {"output":-5}
        },
        {
          "name": "Subtract a negative fraction",
          "input": {"a":-1.25,"b":-2.5},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"output":1.25}
        },
        {
          "name": "Cancellation gives zero",
          "input": 6,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",["NODE"],["NODE"]],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "Subtract near the portable integer limit",
          "input": null,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",999999999999999,999999999999998],["NODE"]]],
          "lazy": {"output":1}
        },
        {
          "name": "Decimal difference at twelve places",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR","at":12},["SUB",0.3,0.2]],["NODE"]]],
          "lazy": {"output":"0.100000000000"}
        },
        {
          "name": "Missing both operands",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB"],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Missing second operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",1],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Extra operand",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",1,2,3],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "Null literal in first position",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",null,2],["NODE"]]],
          "lazy": {"invalid_graft":true}
        },
        {
          "name": "String returned for second operand",
          "input": {"v":"2"},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["SUB",1,["NODE","v"]],["NODE"]]],
          "lazy": {"runtime_error":true}
        },
        {
          "name": "Invalid call in a skipped action",
          "input": "skip",
          "jgraft": ["JGRAFT",{"v":1},["IF","take",["COPY",["SUB",1],["NODE"]]]],
          "lazy": {"output":"skip"},
          "strict": {"invalid_graft":true}
        }
      ]
    },
    {
      "name": "DIV",
      "desc": "Division preserves fractional results. A zero divisor fails for every numerator.",
      "tests": [
        {
          "name": "Integer operands produce a fraction",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DIV",3,8],["NODE"]]],
          "lazy": {"output":0.375}
        },
        {
          "name": "Negative divisor",
          "input": 7,
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DIV",["NODE"],-2],["NODE"]]],
          "lazy": {"output":-3.5}
        },
        {
          "name": "Two negative operands",
          "input": {"a":-7,"b":-2},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DIV",["NODE","a"],["NODE","b"]],["NODE"]]],
          "lazy": {"output":3.5}
        },
        {
          "name": "Zero numerator",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["DIV",0,4],["NODE"]]],
          "lazy": {"output":0}
        },
        {
          "name": "Recurring decimal at twelve places",
          "input": {},
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"STR","at":12},["DIV",2,3]],["NODE"]]],
          "lazy": {"output":"0.666666666667"}
