    {
      "name": "ROUND significant digits and symbolic exponents",
      "desc": "SIG preserves the coarser of input precision after shifting and the rounding position. STR can produce short results even for scientific-notation input.",
      "tests": [
        {
          "name": "Carry preserves units precision",
          "input": "9.9",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"SIG"}],["NODE"]]],
          "lazy": {"output":"1.0e1"}
        },
        {
          "name": "Keep hundredths",
          "input": "9.500",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"SIG","at":2}],["NODE"]]],
          "lazy": {"output":"9.50"}
        },
        {
          "name": "Keep coarse precision",
          "input": "1.25e20",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"SIG","at":-10}],["NODE"]]],
          "lazy": {"output":"1.25e20"}
        },
        {
          "name": "Round at exponent scale",
          "input": "1.25e10",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"SIG","at":-9}],["NODE"]]],
          "lazy": {"output":"1.3e10"}
        },
        {
          "name": "Carry at exponent scale",
          "input": "9.95e6",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"SIG","at":-5}],["NODE"]]],
          "lazy": {"output":"1.00e7"}
        },
        {
          "name": "Round to hundreds",
          "input": "1234",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"SIG","at":-2}],["NODE"]]],
          "lazy": {"output":"1.2e3"}
        },
        {
          "name": "No padding beyond input precision",
          "input": "1.2",
          "jgraft": ["JGRAFT",{"v":1},["COPY",["ROUND",{"as":"SIG","at":4}],["NODE"]]],
